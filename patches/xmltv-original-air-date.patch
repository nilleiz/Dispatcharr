+    def test_original_air_date_episode_number_is_exported(self):
+        """Date-based episode identity survives the XMLTV output round trip."""
+        from django.utils import timezone
+        from apps.epg.models import ProgramData
+
+        epg_source = EPGSource.objects.create(name="Date EPG", source_type="xmltv")
+        epg_data = EPGData.objects.create(
+            name="Date Station", epg_source=epg_source, tvg_id="date.station"
+        )
+        self._add_channel(
+            channel_number=150.0,
+            name="Date Channel",
+            tvg_id="date.station",
+            epg_data=epg_data,
+        )
+        now = timezone.now()
+        ProgramData.objects.create(
+            epg=epg_data,
+            start_time=now + timedelta(hours=1),
+            end_time=now + timedelta(hours=2),
+            title="Terra X",
+            sub_title="Eisige Welten II - Planet der Extreme",
+            tvg_id="date.station",
+            custom_properties={
+                "dd_progid": "EP01646084.0886",
+                "original_air_date": "2023-02-19",
+                "previously_shown": True,
+                "previously_shown_details": {"start": "2023-02-19"},
+            },
+        )
+
+        content = _response_text(
+            self.client.get(self._epg_url("tvg_id_source=tvg_id&days=1"))
+        )
+        tree = ET.fromstring(content)
+        programme = next(
+            item for item in tree.findall(".//programme")
+            if item.findtext("sub-title") == "Eisige Welten II - Planet der Extreme"
+        )
+        episode_numbers = {
+            item.get("system"): item.text for item in programme.findall("episode-num")
+        }
+        self.assertEqual(episode_numbers["dd_progid"], "EP01646084.0886")
+        self.assertEqual(episode_numbers["original-air-date"], "2023-02-19")
+        self.assertEqual(
+            programme.find("previously-shown").get("start"), "2023-02-19"
+        )
+
+        from core.models import CoreSettings, EPG_SETTINGS_KEY
+
+        CoreSettings.objects.create(
+            key=EPG_SETTINGS_KEY,
+            name="EPG Settings",
+            value={"plex_epg_compatibility": True},
+        )
+        compat_content = _response_text(
+            self.client.get(self._epg_url("tvg_id_source=tvg_id&days=1"))
+        )
+        compat_tree = ET.fromstring(compat_content)
+        compat_programme = next(
+            item for item in compat_tree.findall(".//programme")
+            if item.findtext("sub-title") == "Eisige Welten II - Planet der Extreme"
+        )
+        compat_numbers = {
+            item.get("system"): item.text
+            for item in compat_programme.findall("episode-num")
+        }
+        self.assertNotIn("dd_progid", compat_numbers)
+        self.assertEqual(compat_numbers["original-air-date"], "2023-02-19")
+
